# YouTube API key untuk proxy server-side (api/youtube.ts).
# JANGAN pakai prefix VITE_ agar key tidak bocor ke bundle frontend.
YOUTUBE_API_KEY=your_youtube_api_key_here

# API base URL untuk build mobile (Capacitor).
# WAJIB di-set di GitHub Repository Variable "VITE_API_BASE" — WebView butuh URL absolut.
# Fallback CI ada di .github/workflows/mobile-build.yml.
VITE_API_BASE=https://animtubev1.vercel.app
